require "json"
require "optparse"
require_relative "../lib/zero_x_da/trading_lab/replay"
require_relative "../lib/zero_x_da/trading_lab/okx_lead_traders"
require_relative "../lib/zero_x_da/trading_lab/research_store"

def replay(argv)
  options = {}
  parser = OptionParser.new do |p|
    p.banner = "Usage: trading-lab replay PATH [options]"
    { "starting-cash" => "starting_cash", "trade-notional" => "trade_notional", "fee-bps" => "fee_bps",
      "slippage-bps" => "slippage_bps", "max-allocation" => "max_allocation" }.each do |flag, key|
      p.on("--#{flag} VALUE") { |value| options[key] = value }
    end
    p.on("--max-delay-seconds INTEGER", Integer) { |value| options["max_delay_seconds"] = value }
  end
  parser.parse!(argv)
  raise ArgumentError, "expected one JSONL path" unless argv.length == 1
  events = []
  File.foreach(argv.first).each_with_index do |line, index|
    next if line.strip.empty?
    record = JSON.parse(line)
    raise ArgumentError, "line #{index + 1}: expected an object" unless record.is_a?(Hash)
    events << record
  end
  puts JSON.pretty_generate(ZeroXDA::TradingLab::Replay.call(events, options))
end

# Read-only: fetches the public OKX lead trader leaderboard once, without credentials.
def okx_leaders(argv)
  options = {}
  parser = OptionParser.new do |p|
    p.banner = "Usage: trading-lab okx-leaders [options]"
    %w[sort state min-lead-days min-assets max-assets min-aum max-aum data-version page limit].each do |flag|
      p.on("--#{flag} VALUE") { |value| options[flag.tr("-", "_")] = value }
    end
  end
  parser.parse!(argv)
  raise ArgumentError, "unexpected arguments" unless argv.empty?
  puts JSON.pretty_generate(ZeroXDA::TradingLab::OkxLeadTraders.new.ranks(options))
end

# Applies pending research store migrations to TRADING_LAB_DATABASE_URL.
def migrate(argv)
  raise ArgumentError, "unexpected arguments" unless argv.empty?
  store = ZeroXDA::TradingLab::ResearchStore.from_env
  raise ArgumentError, "#{ZeroXDA::TradingLab::ResearchStore::URL_VARIABLE} is not set" unless store
  applied = store.migrate!
  puts applied.empty? ? "research store is up to date" : "applied #{applied.join(', ')}"
end

# Read-only and long-running: records public OKX ticker quotes until stopped. It needs no
# key and can place no order. Ticks go to --output (JSONL), to the research store, or both.
def collect_okx(argv)
  require_relative "../lib/zero_x_da/trading_lab/market_collector"
  require_relative "../lib/zero_x_da/trading_lab/market_tick_store"
  lab = ZeroXDA::TradingLab
  options = { instruments: [], min_interval_ms: 1000 }
  parser = OptionParser.new do |p|
    p.banner = "Usage: trading-lab collect-okx [options]"
    p.on("--instrument ID", "repeatable; default #{lab::OkxTickers::DEFAULT_INSTRUMENTS.join(', ')}") { |value| options[:instruments] << value }
    p.on("--output PATH", "append ticks as JSONL") { |value| options[:output] = value }
    p.on("--min-interval-ms INTEGER", Integer, "keep at most one tick per instrument per interval") { |value| options[:min_interval_ms] = value }
    p.on("--max-events INTEGER", Integer, "stop after this many kept ticks") { |value| options[:max_events] = value }
  end
  parser.parse!(argv)
  raise ArgumentError, "unexpected arguments" unless argv.empty?
  sinks = []
  sinks << lab::MarketCollector::JsonlSink.new(options[:output]) if options[:output]
  store = lab::ResearchStore.from_env
  if store
    store.migrate!
    sinks << lab::MarketCollector::StoreSink.new(lab::MarketTickStore.new(store))
  end
  raise ArgumentError, "give --output or set #{lab::ResearchStore::URL_VARIABLE}" if sinks.empty?
  stopping = false
  %w[INT TERM].each { |signal| trap(signal) { stopping = true } }
  instruments = options[:instruments].empty? ? lab::OkxTickers::DEFAULT_INSTRUMENTS : options[:instruments]
  count = lab::MarketCollector.new(sinks: sinks, instruments: instruments, min_interval_ms: options[:min_interval_ms],
                                   max_events: options[:max_events], stop: -> { stopping }).run
  warn "market collector: kept #{count} ticks"
end

# Read-only and long-running: watches the public web preview of Telegram channels, keeps
# every revision of their posts and rates their calls. It needs no Telegram credential.
def collect_telegram(argv)
  require_relative "../lib/zero_x_da/trading_lab/telegram_signal_collector"
  lab = ZeroXDA::TradingLab
  options = { channels: ENV.fetch("TRADING_LAB_TELEGRAM_CHANNELS", "").split(","), interval_seconds: 60, backfill_pages: 0, horizon_hours: 24, delay_seconds: 5 }
  parser = OptionParser.new do |p|
    p.banner = "Usage: trading-lab collect-telegram --channel NAME [options]"
    p.on("--channel NAME", "public channel username; repeatable") { |value| options[:channels] << value }
    p.on("--interval-seconds INTEGER", Integer, "pause between polling cycles (default 60)") { |value| options[:interval_seconds] = value }
    p.on("--backfill-pages INTEGER", Integer, "older pages to store once at start; kept, never rated") { |value| options[:backfill_pages] = value }
    p.on("--horizon-hours INTEGER", Integer, "how long a call has to reach its target (default 24)") { |value| options[:horizon_hours] = value }
    p.on("--delay-seconds INTEGER", Integer, "follower delay before the entry quote (default 5)") { |value| options[:delay_seconds] = value }
    p.on("--once", "run one cycle and exit") { options[:once] = true }
  end
  parser.parse!(argv)
  raise ArgumentError, "unexpected arguments" unless argv.empty?
  store = lab::ResearchStore.from_env
  raise ArgumentError, "#{lab::ResearchStore::URL_VARIABLE} is not set" unless store
  store.migrate!
  signals = lab::TelegramSignalStore.new(store)
  rating = lab::SignalRating.new(signals: signals, horizon_hours: options[:horizon_hours], delay_seconds: options[:delay_seconds],
                                 max_lag_seconds: lab::TelegramSignalStore::MAX_LAG_SECONDS)
  stopping = false
  %w[INT TERM].each { |signal| trap(signal) { stopping = true } }
  collector = lab::TelegramSignalCollector.new(channels: options[:channels], signals: signals, rating: rating, interval_seconds: options[:interval_seconds],
                                               backfill_pages: options[:backfill_pages], stop: -> { stopping })
  collector.run(once: options[:once] == true)
end

command = ARGV.shift
begin
  case command
  when "replay" then replay(ARGV)
  when "okx-leaders" then okx_leaders(ARGV)
  when "migrate" then migrate(ARGV)
  when "collect-okx" then collect_okx(ARGV)
  when "collect-telegram" then collect_telegram(ARGV)
  else raise ArgumentError, "expected replay PATH, okx-leaders, migrate, collect-okx or collect-telegram"
  end
rescue ArgumentError, OptionParser::ParseError, JSON::ParserError, Errno::ENOENT => error
  warn "#{command || 'trading-lab'} error: #{error.message}"
  exit 2
rescue ZeroXDA::TradingLab::OkxLeadTraders::Error => error
  warn "okx error: #{error.message}"
  exit 3
rescue ZeroXDA::TradingLab::ResearchStore::Unavailable => error
  warn "store error: #{error.message}"
  exit 4
rescue StandardError => error
  # A collector stopped by a rejected subscription, a backwards clock or a full buffer.
  raise unless command == "collect-okx"
  warn "collector error: #{error.message}"
  exit 5
end
